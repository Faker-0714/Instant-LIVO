<launch>

	<arg name="rviz" default="true" />
  <arg name="config" default="mid_360.yaml" doc="Dataset YAML filename in config/." />
  <arg name="camera_config" default="camera_pinhole.yaml" />
  <arg name="bag_enable" default="" doc="Empty keeps common/bag_enable from YAML." />
  <arg name="bag_path" default="" doc="Empty keeps common/bag_path from YAML." />

  <rosparam command="load" file="$(find instant_livo)/config/$(arg config)" />
  <param name="common/bag_enable" type="bool" value="$(arg bag_enable)" if="$(eval arg('bag_enable') != '')" />
  <param name="common/bag_path" type="str" value="$(arg bag_path)" if="$(eval arg('bag_path') != '')" />

	<node pkg="instant_livo" type="instant_livo_mapping" name="laserMapping" output="screen" required="true">
		<rosparam file="$(find instant_livo)/config/$(arg camera_config)" />
	</node>
	
	<group if="$(arg rviz)">
		<node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find instant_livo)/rviz_cfg/instant_livo.rviz" />
	</group>
	
	<node unless="$(eval arg('bag_enable') == True)" pkg="image_transport" type="republish" name="republish" args="compressed in:=/left_camera/image raw out:=/left_camera/image" output="screen" respawn="true"/>

</launch> 	
